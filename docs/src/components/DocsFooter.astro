import { IconNavArrow } from 'components/Icon/IconNavArrow';
import type { RouteMeta } from 'components/Layout/getRouteMeta';

type Props = Pick<RouteMeta, 'route' | 'nextRoute' | 'prevRoute'>;

const { route, nextRoute, prevRoute } = Astro.props;

const linkClasses =
  'flex gap-x-4 md:gap-x-6 items-center w-full md:w-80 px-4 md:px-5 py-6 border-2 border-transparent text-base leading-base text-link dark:text-link-dark rounded-lg group focus:text-link dark:focus:text-link-dark focus:bg-highlight focus:border-link dark:focus:bg-highlight-dark dark:focus:border-link-dark focus:border-2 focus:ring-1 focus:ring-offset-4 focus:ring-blue-40 active:ring-0 active:ring-offset-0 hover:bg-gray-5 dark:hover:bg-gray-80';

const show = route && !route.heading && (prevRoute?.path || nextRoute?.path);
---

{
  show && (
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4 py-4 md:py-12">
      {prevRoute?.path ? (
        <a href={prevRoute.path} class={linkClasses}>
          <IconNavArrow
            className="text-gray-30 dark:text-gray-50 inline group-focus:text-link dark:group-focus:text-link-dark"
            displayDirection="left"
          />
          <span>
            <span class="block no-underline text-sm tracking-wide text-secondary dark:text-secondary-dark uppercase font-bold group-focus:text-link dark:group-focus:text-link-dark">
              Previous
            </span>
            <span class="block text-lg group-hover:underline">
              {prevRoute.title}
            </span>
          </span>
        </a>
      ) : (
        <div />
      )}

      {nextRoute?.path ? (
        <a
          href={nextRoute.path}
          class:list={[
            linkClasses,
            'flex-row-reverse justify-self-end text-right',
          ]}>
          <IconNavArrow
            className="text-gray-30 dark:text-gray-50 inline group-focus:text-link dark:group-focus:text-link-dark"
            displayDirection="right"
          />
          <span>
            <span class="block no-underline text-sm tracking-wide text-secondary dark:text-secondary-dark uppercase font-bold group-focus:text-link dark:group-focus:text-link-dark">
              Next
            </span>
            <span class="block text-lg group-hover:underline">
              {nextRoute.title}
            </span>
          </span>
        </a>
      ) : (
        <div />
      )}
    </div>
  )
}
