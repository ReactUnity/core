---
/*
 * Copyright (c) Facebook, Inc. and its affiliates.
 */

// Ids come from plugins/remark-header-custom-ids.js, which is also what the sidebar
// table of contents links to.
interface Props {
  as: 'h1' | 'h2' | 'h3' | 'h4';
  id?: string;
  class?: string;
}

const { as: Tag, id, class: className }: Props = Astro.props;
const label = 'Link for this heading';

/*
 * The h1 gets an anchor too, hidden. useTocHighlight walks `.mdx-header-anchor`
 * elements to decide which entry is active, and the table of contents starts with an
 * "Overview" row pointing at the top of the page -- so the h1's anchor is what keeps
 * those two lists index-aligned. Dropping it silently shifts every highlight by one.
 */
---

<Tag id={id} class:list={['mdx-heading', className]}>
  <slot />
  {
    (
      <a
        href={id ? `#${id}` : '#'}
        aria-label={label}
        title={label}
        class:list={[
          'mdx-header-anchor',
          Tag === 'h1' ? 'hidden' : 'inline-block',
        ]}>
        <svg
          width="1em"
          height="1em"
          viewBox="0 0 13 13"
          xmlns="http://www.w3.org/2000/svg"
          class="text-gray-70 ml-2 h-5 w-5">
          <g fill="currentColor" fill-rule="evenodd">
            <path d="M7.778 7.975a2.5 2.5 0 0 0 .347-3.837L6.017 2.03a2.498 2.498 0 0 0-3.542-.007 2.5 2.5 0 0 0 .006 3.543l1.153 1.15c.07-.29.154-.563.25-.773.036-.077.084-.16.14-.25L3.18 4.85a1.496 1.496 0 0 1 .002-2.12 1.496 1.496 0 0 1 2.12 0l2.124 2.123a1.496 1.496 0 0 1-.333 2.37c.16.246.42.504.685.752z" />
            <path d="M5.657 4.557a2.5 2.5 0 0 0-.347 3.837l2.108 2.108a2.498 2.498 0 0 0 3.542.007 2.5 2.5 0 0 0-.006-3.543L9.802 5.815c-.07.29-.154.565-.25.774-.036.076-.084.16-.14.25l.842.84c.585.587.59 1.532 0 2.122-.587.585-1.532.59-2.12 0L6.008 7.68a1.496 1.496 0 0 1 .332-2.372c-.16-.245-.42-.503-.685-.75z" />
          </g>
        </svg>
      </a>
    )
  }
</Tag>
