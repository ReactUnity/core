import ButtonLink from 'components/ButtonLink.astro';
import { IconNavArrow } from 'components/Icon/IconNavArrow';

interface Props {
  title: string;
  path: string;
}

const { title, path } = Astro.props;
---

<div
  class="flex flex-col h-full bg-card dark:bg-card-dark shadow-inner justify-between rounded-lg pb-8 p-6 xl:p-8 mt-3">
  <div>
    <h4
      class="text-primary dark:text-primary-dark font-bold text-2xl leading-tight">
      {title}
    </h4>
    <div class="my-4"><slot /></div>
  </div>
  <div>
    <ButtonLink href={path} class="mt-1" type="primary" size="md" label={title}>
      Read More
      <IconNavArrow displayDirection="right" className="inline ml-1" />
    </ButtonLink>
  </div>
</div>
