{
  "name": "@reactunity/renderer",
  "version": "0.23.1",
  "description": "React renderer for Unity3D",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "main": "dist/index.js",
  "sideEffects": false,
  "files": ["dist"],
  "//exports": "`./tests` is the entry that exists: the source file is tests.ts and packages/scripts/lib/types/tests.d.ts references `@reactunity/renderer/tests`. The map only ever declared `./test`, pointed at ./dist/test.js -- a name tsc never emitted -- so both spellings failed to resolve under an exports-aware resolver. `./test` is kept as an alias for the same file rather than dropped, since it costs nothing and it is the name published so far.",
  "exports": {
    ".": "./dist/index.js",
    "./tests": "./dist/tests.js",
    "./test": "./dist/tests.js",
    "./ugui": "./dist/ugui/index.js",
    "./ugui/*": "./dist/ugui/*.js",
    "./uitoolkit": "./dist/uitoolkit/index.js",
    "./uitoolkit/*": "./dist/uitoolkit/*.js",
    "./editor": "./dist/editor/index.js",
    "./editor/*": "./dist/editor/*.js",
    "./webgl-compat": "./dist/webgl-compat.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "prepack": "pnpm run build",
    "watch": "tsdown --watch",
    "lint": "react-unity-scripts lint",
    "version": "node version.js && git add src/version.ts"
  },
  "author": "Gokhan Kurt <krtgkn@gmail.com> (https://github.com/KurtGokhan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReactUnity/core.git",
    "directory": "packages/renderer"
  },
  "keywords": ["react", "react-renderer", "unity", "unity3d"],
  "dependencies": {
    "react-reconciler": "^0.33.0",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@reactunity/scripts": "workspace:^",
    "@types/react-reconciler": "^0.33.0",
    "react-unity-webgl": "^10.2.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/ReactUnity/core/issues"
  },
  "homepage": "https://github.com/ReactUnity/core/tree/main/packages/renderer#readme",
  "publishConfig": {
    "access": "public"
  }
}
