{
  "extends": "@reactunity/scripts",
  "compilerOptions": {
    // Type checking only: tsdown.config.ts owns the build, so nothing here describes
    // output any more -- no outDir, no declaration, no sourceMap. `target` no longer
    // decides what ships either (the bundler's `target: 'es2015'` does); what it still
    // does is gate which syntax tsc accepts, so it is set to match the lib below.
    "noEmit": true,
    "target": "ES2022",
    // ES2022 because the renderer calls Object.hasOwn (src/renderer/diffing.ts,
    // async/serializer.ts, the subcontexts), which is an ES2022 API. `lib` is a statement
    // about which APIs the host engine provides, so it belongs to Unity's JS engines
    // rather than to the build.
    "lib": ["ES2022"],
    "types": []
  },
  "files": [
    "index.ts",
    "tests.ts",
    "ugui/index.ts",
    "ugui/jsx-dev-runtime.ts",
    "ugui/jsx-runtime.ts",
    "uitoolkit/index.ts",
    "uitoolkit/jsx-dev-runtime.ts",
    "uitoolkit/jsx-runtime.ts",
    "editor/index.ts",
    "editor/jsx-dev-runtime.ts",
    "editor/jsx-runtime.ts",
    "webgl-compat.ts"
  ]
}
