{
  "extends": "@reactunity/scripts",
  "compilerOptions": {
    // Type checking only -- tsdown.config.ts owns the build. `baseUrl` went with it: it
    // was never doing any work (every import under src/ is relative), and TypeScript 7
    // removed the option anyway.
    "noEmit": true,
    "target": "ES2022",
    "jsxImportSource": "@reactunity/renderer/ugui",
    "types": ["@reactunity/scripts/main"]
  },
  "files": ["index.ts"],
  "include": ["src"]
}
